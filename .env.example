# ---------- Discord (https://discord.com/developers/applications) ----------
DISCORD_TOKEN=                 # Bot > Reset Token. Enable "Message Content" and "Server Members" intents on the same page.
DISCORD_CLIENT_ID=             # General Information > Application ID (slash commands + invite link)
DISCORD_GUILD_IDS=             # optional: server id(s), comma separated. Empty = every server the bot is in
MOD_LOG_CHANNEL_ID=            # private staff channel for reports with Delete / Timeout / Ban / False positive buttons
WELCOME_CHANNEL_ID=            # optional: where new members are greeted
HELP_CHANNEL_IDS=              # optional: channels where every question gets answered automatically
IGNORED_CHANNEL_IDS=           # optional: channels the bot never scans (e.g. staff chat)
MOD_ROLE_IDS=                  # optional: pinged on urgent cases, never auto-punished
EXEMPT_ROLE_IDS=               # optional: other roles never auto-punished (trusted members, bots)
REGISTER_COMMANDS_ON_START=true

# ---------- Behaviour ----------
MOD_MODE=enforce               # enforce | observe (shadow mode: report only, never delete - use for the first week)
AI_SCAN=all                    # all | suspicious (only messages the rules pre-flag: cheapest) | off (rules only)
AI_MAX_PER_MINUTE=30           # AI budget; over it, only suspicious messages go to the AI
AUTO_ANSWER=true               # answer questions in HELP_CHANNEL_IDS and from new members
NEW_MEMBER_DAYS=7
ANSWER_NEW_MEMBERS_ANYWHERE=true
WELCOME_ENABLED=true
WELCOME_DM=false
KNOWLEDGE_FILE=                # default knowledge/community.json

# ---------- Thresholds (0-100) ----------
SPAM_FLAG_SCORE=35
SPAM_DELETE_SCORE=60
TOX_FLAG_SCORE=45
TOX_DELETE_SCORE=70
TOX_TIMEOUT_SCORE=88
TIMEOUT_MINUTES=60
FLOOD_TIMEOUT_MINUTES=10
SCAM_TIMEOUT_MINUTES=1440
STRIKE_WINDOW_HOURS=24
STRIKES_FOR_TIMEOUT=3
STRIKES_FOR_LONG_TIMEOUT=5
LONG_TIMEOUT_MINUTES=1440
FLOOD_COUNT=5
FLOOD_WINDOW_SECONDS=7
DUPLICATE_COUNT=3
DUPLICATE_WINDOW_SECONDS=60
MAX_MENTIONS=5
NEW_ACCOUNT_DAYS=7
MIN_ACCOUNT_AGE_DAYS=3
RAID_JOIN_COUNT=8
RAID_WINDOW_SECONDS=60
ALLOW_INVITES=false
ALLOWED_DOMAINS=               # e.g. yourgame.com,docs.yourgame.com
BLOCKED_DOMAINS=
BLOCKED_WORDS=                 # server-specific slurs / banned terms, comma separated (always removed)

# ---------- Alerts ----------
ALERT_WEBHOOK_URL=             # Slack / Discord webhook / Zapier / n8n URL for urgent cases (threats, self-harm, raids)

# ---------- AI (multi-model fallback: Gemini versions -> Groq -> NVIDIA -> OpenRouter -> Ollama) ----------
GEMINI_API_KEY=                # https://aistudio.google.com/apikey
GROQ_API_KEY=                  # https://console.groq.com/keys (free, very fast)
NVIDIA_API_KEY=                # https://build.nvidia.com (free credits)
OPENROUTER_API_KEY=            # https://openrouter.ai/keys (":free" models)
# OLLAMA_BASE_URL=http://localhost:11434/v1
# AI_CHAIN=gemini:gemini-3.6-flash,gemini:gemini-3-flash-preview,groq:llama-3.3-70b-versatile,openrouter:openrouter/free
AI_TIMEOUT_MS=8000             # per model, while another model is left to try
AI_TOTAL_BUDGET_MS=20000       # whole answer
AI_HEDGE_MS=4000               # start the next model in parallel if the current one is silent this long (0 = off)

# ---------- Server ----------
PORT=3000                      # GET /health for Docker / Railway / Render (0 = off)
DATA_DIR=./data
LOG_LEVEL=info
